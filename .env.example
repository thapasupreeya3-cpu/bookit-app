# /etc/bookit.env — every setting BookIt reads, with its default.
# Copy to /etc/bookit.env (root-readable only: chmod 600) and fill in what you use.
# The service and the backup timer both read this one file, so paths cannot disagree.
# A line that is commented out is a default you are accepting.

# ---------- where things are ----------
#PORT=3000                       # Node listens here; Caddy proxies to it
#BIND_HOST=127.0.0.1             # only Caddy can reach it; never 0.0.0.0 behind Caddy
#DB_PATH=/home/ubuntu/bookit-app/bookit.db
#DOCS_DIR=/home/ubuntu/bookit-app/bookit-docs      # uploaded documents (default: beside the db)
#PHOTOS_DIR=/home/ubuntu/bookit-app/bookit-photos  # profile photos (default: beside the db)
#SECRET_FILE=/home/ubuntu/bookit-app/.secret       # the signing secret is generated here if SESSION_SECRET is not set
APP_URL=https://bookit.life      # used in every emailed link, the sitemap and canonical tags
TRUST_PROXY=on                   # read X-Forwarded-* from Caddy (required behind Caddy)
NODE_ENV=production              # turns the production preflight on: Secure cookies, admin MFA, fail-closed checks
#TZ=Australia/Sydney             # the server's clock for shifts and cancellation windows (default)

# ---------- who is the office ----------
ADMIN_EMAILS=                    # comma-separated; applied to VERIFIED accounts at boot (or: node server.js grant-admin <email>)
#ADMIN_MFA_REQUIRED=on           # default on in production, off on plain http
#ADMIN_IDLE_HOURS=12             # an office session unused this long is over (admins only)
#SESSION_SECRET=                 # optional: set once and keep; changing it signs everyone out (otherwise SECRET_FILE is used)

# ---------- the front door ----------
#SITE_PASSWORD=                  # one shared password in front of the whole site while pre-launch; remove to open
#PUBLIC_WORKER_NAMES=short       # what a visitor without an account sees on the directory: short ("Zoe T.") or full
#SEED_DEMO=on                    # the twelve demo workers and the demo participant; set off for a clean database
#AUTO_REPLY=on                   # the demo workers' automatic message acknowledgement

# ---------- email (one of the two) ----------
RESEND_API_KEY=                  # Resend, preferred
#RESEND_BASE=https://api.resend.com
#SMTP_HOST=smtppro.zoho.com.au   # or SMTP
#SMTP_PORT=465
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=hello@bookit.life     # default: SMTP_USER, then hello@bookit.life

# ---------- money ----------
STRIPE_SECRET_KEY=               # self-managed participants pay by card; empty = card payments off
STRIPE_WEBHOOK_SECRET=           # from the Stripe dashboard for POST /api/stripe/webhook
#STRIPE_API_URL=https://api.stripe.com
BANK_DETAILS=                    # shown on invoices for bank transfer, e.g. "BSB 000-000 · Account 12345678 · DMHC Pty Ltd"

# ---------- the provider ----------
#NDIS_REG_NO=4-LO5XNY0           # printed on agreements and invoices
#CERT_SCH2=                      # high-intensity supports the provider is certified for: key:expiry pairs, e.g. catheter:2027-03-14,peg:2027-03-14 (keys as in /api/scope)
#SCOPE_PARTNER_NAME=             # the specialist-supports partner named on the scope page, if any
#SCOPE_PARTNER_NDIS=
#SCOPE_PARTNER_PHONE=
#SCOPE_PARTNER_AGREEMENT_AT=

# ---------- uploads and limits ----------
#UPLOAD_MAX_BYTES=12582912       # 12 MB per file
#UPLOAD_MAX_PIXELS=25000000      # 25 megapixels per image
#RATE_LIMIT_RETRY_AFTER_SECONDS=60
#ALLOW_LEGACY_NO_ORIGIN=off      # accept state-changing requests with no Origin header (old clients only)

# ---------- the AI layer (default: off) ----------
#AI_REGION=                      # must name an Australian region before live mode is allowed
#AI_ENDPOINT=                    # the model endpoint; nothing leaves the box while this is empty
#AI_API_KEY=
#AI_MODEL=

# ---------- backups (scripts/backup.js, run by ops/bookit-backup.timer) ----------
BACKUP_DIR=/home/ubuntu/backups  # nightly sets are written here (default: backups/ beside the db)
#BACKUP_KEEP_DAYS=35             # prune sets older than this …
#BACKUP_KEEP_MIN=3               # … but never below this many sets
BACKUP_S3_URI=                   # e.g. s3://dmhc-bookit-backups/bookit — empty means the sets exist only on this machine
#AWS_DEFAULT_REGION=ap-southeast-2
#AWS_ACCESS_KEY_ID=              # only if you use an IAM user (option B in ops/README.md); a Lightsail bucket attached to the instance needs no keys
#AWS_SECRET_ACCESS_KEY=
#BACKUP_ALLOW_MISSING_DIRS=off   # fresh install only; on a running site a missing folder means a wrong path and the run fails

# ---------- release stamps (set by the deploy script, informational) ----------
#BUILD_SHA=                      # GIT_COMMIT is accepted as an alias
#BUILD_DATE=

# Accepted for older installs only, do not use in a new one: BOOKIT_SECRET, BOOKIT_SESSION_SECRET and SECRET
# are aliases of SESSION_SECRET; ADMIN_BOOTSTRAP does nothing and is warned about; SCHEMA_VERSION is internal.
