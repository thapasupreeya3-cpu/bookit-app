{
  "name": "bookit-site-v65",
  "version": "88.3.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "lint": "node scripts/lint.js",
    "test": "node --no-warnings tests/clash-tests.js && node --no-warnings tests/smoke.js && npm run test:review && npm run test:graphics && npm run test:audit && npm run test:process && npm run test:verification && npm run test:settings && npm run test:navigation && npm run test:credentials && npm run test:next-actions && npm run test:calendar && npm run test:launch",
    "inventory": "node scripts/inventory.js",
    "check": "npm run lint && node --no-warnings scripts/inventory.js --verify && node scripts/release-docs.js --verify && node scripts/verify-release.js && npm test",
    "backup": "node --no-warnings scripts/backup.js",
    "test:review": "node --no-warnings tests/review-unit-tests.js && node --no-warnings tests/review-regression.js",
    "release:docs": "node scripts/inventory.js && node scripts/release-docs.js",
    "review:data": "node --no-warnings scripts/review-existing-data.js",
    "test:graphics": "node --no-warnings tests/graphics-tests.js",
    "test:audit": "node --no-warnings tests/audit-unit-tests.js && node --no-warnings tests/audit-fixes.js",
    "test:process": "node --no-warnings tests/process-regression.js",
    "test:verification": "node --no-warnings tests/admin-verification-tests.js",
    "test:settings": "node --no-warnings tests/account-settings-tests.js",
    "test:navigation": "node --no-warnings tests/navigation-tests.js",
    "test:credentials": "node --no-warnings tests/credentials-tests.js",
    "test:next-actions": "node --no-warnings tests/next-actions-tests.js",
    "test:calendar": "node --no-warnings tests/booking-calendar-tests.js",
    "test:launch": "node --no-warnings tests/launch-regression.js"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12 <23"
  }
}
